* {
    font-family: "Segoe UI", "Poppins", sans-serif;
}

QMainWindow {
    background-color: #0F0F1A;
}

/* Sidebar */
QWidget#sidebar {
    background-color: #12121C;
}

/* Título */
QLabel#title {
    color: #A855F7;
    font-size: 22px;
    font-weight: bold;
}

/* Seções */
QLabel#sectionTitle {
    color: #00ADB5;
    font-size: 14px;
    font-weight: bold;
    margin-top: 10px;
}

/* Botões */
QPushButton {
    background-color: #1E1E2E;
    color: white;
    border-radius: 8px;
    padding: 10px;
    text-align: left;
}

QPushButton:hover {
    background-color: #A855F7;
}

QPushButton:pressed {
    background-color: #9333EA;
}

/* Inputs */
QLineEdit {
    background-color: #1E1E2E;
    color: #E4E4E7;
    border: 2px solid #2A2A40;
    border-radius: 8px;
    padding: 8px;
}

QLineEdit:focus {
    border: 2px solid #A855F7;
}

/* IMAGENS (hack seguro) */
QLabel {
    border: none;
}